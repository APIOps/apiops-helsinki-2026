---
import BaseLayout from "../../layouts/BaseLayout.astro";
import communities from "../../data/communities.json";
import eventData from "../../data/events.json";
import { getCurrentEvents } from "../../utils/events";
export function getStaticPaths() { return communities.map((community) => ({ params: { slug: community.slug }, props: { community } })); }
const { community } = Astro.props;
const events = getCurrentEvents(eventData);
const localEvents = events.filter((event) => event.region === community.slug && event.status !== "Past event");
const recentEvents = events.filter((event) => event.region === community.slug && event.status === "Past event").reverse().slice(0, 3);
const interestUrl = "https://tally.so/r/3yQEpp";
function getOrganizerName(organizer) {
  return typeof organizer === "string" ? organizer : organizer.name;
}

function getOrganizerUrl(organizer) {
  return typeof organizer === "string" ? "" : organizer.url;
}
---
<BaseLayout title={`APIOps ${community.name}`} description={community.intro}>
  <nav class="community-nav"><div class="container nav-inner"><a class="brand" href="/"><img class="brand-logo" src="/favicon.svg" alt="APIOps logo" /><strong>APIOps {community.name}</strong></a><div class="nav-links"><a href="/communities">All communities</a><a href="/insights">Insights</a><a href="/events">Event Calendar</a></div></div></nav>
  <main class="community-page"><header class="local-hero"><div class="container"><p class="community-eyebrow">{community.planned ? "Community in formation" : "Local APIOps community"}</p><h1>{community.name}</h1><p>{community.intro}</p><div class="community-actions">{community.planned && <a class="button primary" href={interestUrl}>Help start APIOps in {community.name}</a>}{community.meetupLinks.map((meetup) => <a class="button primary" href={meetup.url}>Find {meetup.label} on Meetup</a>)}<a class="button secondary" href="/communities">All local communities</a></div></div></header>
  <section class="section section-light"><div class="container local-detail-grid"><article><p class="small-pill">Local organizers</p><h2>People making it happen</h2>{community.organizers.map((item) => <p>{getOrganizerUrl(item) ? <a href={getOrganizerUrl(item)}>{getOrganizerName(item)}</a> : getOrganizerName(item)}</p>)}</article><article><p class="small-pill">Cities</p><h2>Where we connect</h2><p>{community.cities.join(", ")}</p></article><article><p class="small-pill">Partners</p><h2>Community support</h2>{community.partners.map((item) => <p>{item}</p>)}</article></div></section>
  <section class="section"><div class="container"><div class="community-section-head"><p class="small-pill">Event calendar</p><h2>Upcoming events in {community.name}</h2><p>Events are filtered for this local community.</p></div>{localEvents.length ? <div class="community-home-calendar">{localEvents.map((event) => <article class="community-date-card"><div class="community-date-tile"><span>{event.month}</span><strong>{event.day || "TBA"}</strong><small>{event.year}</small></div><div class="community-date-body"><h3>{event.title}</h3><p class="community-event-meta">{event.location} · {event.format}</p>{event.time && <p class="community-event-meta">{event.time}</p>}{event.venueAddress && <p class="community-event-meta">{event.venueAddress}</p>}<p>{event.description}</p>{event.practicalInfo && <p>{event.practicalInfo}</p>}<a class="community-action-primary" href={event.learnUrl}>Learn more</a></div></article>)}</div> : <div class="local-empty"><h3>{community.planned ? "Help shape the first meetup." : "No upcoming dates announced here yet."}</h3><p>{community.planned ? "Express your interest in organizing, hosting, or joining local activities." : "Check the local Meetup group for the latest announcements and registration details."}</p><div class="community-actions">{community.planned && <a class="button primary" href={interestUrl}>Help start APIOps in {community.name}</a>}{community.meetupLinks.map((meetup) => <a class="button primary" href={meetup.url}>Join {meetup.label}</a>)}</div></div>}</div></section>
  {recentEvents.length > 0 && <section class="section section-light"><div class="container">
    <div class="community-section-head"><p class="small-pill">Recent events</p><h2>Recent events in {community.name}</h2><p>Explore past community sessions and available materials.</p></div>
    <div class="community-home-calendar">{recentEvents.map((event) => <article class="community-date-card">
      <div class="community-date-tile"><span>{event.month}</span><strong>{event.day}</strong><small>{event.year}</small></div>
      <div class="community-date-body"><h3>{event.title}</h3><p class="community-event-meta">{event.location} · {event.format} · Past event</p><p>{event.description}</p><a class="community-action-primary" href={event.learnUrl}>View event details</a></div>
    </article>)}</div>
  </div></section>}
  </main>
</BaseLayout>
